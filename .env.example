# Lokale Entwicklung: Pfad zur SQLite-Datei
DATABASE_URL=local.db

# Docker: Adresse genau so, wie sie im Browser steht (Protokoll, Host und Port).
# Ohne Angabe gilt http://localhost:3000 zum lokalen Testen.
# PUBLIC_URL=https://myfam.example.com
# Port auf dem Host, an den der Reverse Proxy weiterleitet (Standard 3000)
# PORT=3000
# Standardmäßig nur von diesem Host erreichbar. 0.0.0.0, wenn der Proxy auf einem anderen Rechner läuft.
# BIND=127.0.0.1
# Automatische Angebote über marktguru.de (siehe README, deren AGB verbieten automatisches Auslesen)
# MARKTGURU_ENABLED=true
# Push-Erinnerungen: Schlüssel werden sonst automatisch erzeugt und in der Datenbank gespeichert.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Kontaktadresse für die Push-Dienste, Standard ist PUBLIC_URL (wenn https)
# VAPID_SUBJECT=mailto:du@example.com
